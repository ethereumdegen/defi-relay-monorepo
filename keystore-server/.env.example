# ===========================================
# Keystore Server Configuration
# ===========================================

# -----------------------------
# Required
# -----------------------------

# PostgreSQL connection string
# Format: postgres://user:password@host:port/database
# For DigitalOcean managed DB, use the connection string from dashboard
DATABASE_URL=postgres://user:password@localhost:5432/keystore

# -----------------------------
# Server Settings
# -----------------------------

# Server port (default: 3000)
PORT=3000

# Domain for SIWE messages - MUST match your deployed domain
# This is used in the SIWE challenge message that users sign
KEYSTORE_DOMAIN=keystore.defirelay.com

# CORS allowed origins (comma-separated)
# Add your frontend domains here
ALLOWED_ORIGINS=https://stark.defirelay.com,http://localhost:5173

# -----------------------------
# Session & Security
# -----------------------------

# Session token TTL in seconds (default: 1 hour)
SESSION_TTL_SECS=3600

# SIWE challenge TTL in seconds (default: 5 minutes)
CHALLENGE_TTL_SECS=300

# Maximum encrypted data size in bytes (default: 10MB)
# This limits the size of backups users can store
MAX_ENCRYPTED_DATA_SIZE=10485760

# -----------------------------
# Logging
# -----------------------------

# Rust logging level
# Options: error, warn, info, debug, trace
RUST_LOG=keystore_server=info,tower_http=info

# -----------------------------
# x402 Payments (OPTIONAL)
# -----------------------------
# If you want to charge for backup storage, configure these.
# If not set, storage is FREE.

# Your wallet address that receives payments
# Setting this enables x402 payment requirement
# X402_WALLET_ADDRESS=0xYourWalletAddress

# x402 facilitator URL (default: pay2.defirelay.com)
# X402_FACILITATOR_URL=https://pay2.defirelay.com

# Facilitator signer address (REQUIRED if X402_WALLET_ADDRESS is set)
# X402_FACILITATOR_SIGNER=0xFacilitatorSignerAddress

# Payment token contract address (REQUIRED if X402_WALLET_ADDRESS is set)
# X402_PAYMENT_TOKEN_ADDRESS=0xTokenContractAddress

# Payment amount per backup (in wei/smallest unit)
# Default: 1000 tokens with 18 decimals
# X402_COST_PER_BACKUP=1000000000000000000000

# Payment network (default: base-sepolia)
# Options: base-sepolia, base, etc.
# X402_PAYMENT_NETWORK=base-sepolia

# Token metadata
# X402_PAYMENT_TOKEN_SYMBOL=STARKBOT
# X402_PAYMENT_TOKEN_DECIMALS=18
# X402_PAYMENT_TOKEN_NAME=StarkBot
# X402_PAYMENT_TOKEN_VERSION=1
