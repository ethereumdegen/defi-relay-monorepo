# Database connection
DATABASE_URL=postgres://user:password@localhost:5432/keystore

# Server port
PORT=3000

# Domain for SIWE messages
KEYSTORE_DOMAIN=keystore.defirelay.com

# Session TTL in seconds (default: 1 hour)
SESSION_TTL_SECS=3600

# Challenge TTL in seconds (default: 5 minutes)
CHALLENGE_TTL_SECS=300

# Max encrypted data size in bytes (default: 1MB)
MAX_ENCRYPTED_DATA_SIZE=1048576

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=https://stark.defirelay.com,http://localhost:5173

# Logging level
RUST_LOG=keystore_server=debug,tower_http=debug
