# DeFi Relay Quoter Configuration

# Required: Wallet address to receive payments
WALLET_ADDRESS=0x1234567890123456789012345678901234567890

# Required: x402 facilitator URL
FACILITATOR_URL=https://facilitator.x402.org

# Optional: Server port (default: 8080)
PORT=8080

# Optional: Cost per price request in raw USDC (6 decimals, default: 500 = $0.0005)
# Price endpoints are indicative/lightweight
COST_PER_PRICE=500

# Optional: Cost per quote request in raw USDC (6 decimals, default: 1000 = $0.001)
# Quote endpoints return full transaction data
COST_PER_QUOTE=1000

# Optional: Base URL for x402 discovery document
BASE_URL=https://quoter.defirelay.com

# Required: 0x API key
ZEROX_API_KEY=your-0x-api-key-here

# Optional: 0x API base URL (default: https://api.0x.org)
ZEROX_BASE_URL=https://api.0x.org
