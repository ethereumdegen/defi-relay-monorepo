# Moonshot Kimi API Configuration
# Get your API key at: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=your-moonshot-api-key

# Moonshot endpoint (optional, defaults to https://api.moonshot.ai/v1/chat/completions)
# MOONSHOT_ENDPOINT=https://api.moonshot.ai/v1/chat/completions

# Model configuration (optional, defaults to kimi-k2.5)
# KIMI_MODEL=kimi-k2.5

# Bot Wallet (receives payments)
BOT_WALLET_ADDRESS=0xYourBotWalletAddress

# Facilitator Service
FACILITATOR_URL=http://localhost:3000

# Server Configuration
PORT=8080
COST_PER_REQUEST=1000

# Base URL for x402 discovery document (optional)
# Set this to your public domain for /.well-known/x402 to be generated
BASE_URL=https://yourdomain.com

# Token limits (optional)
# MAX_INPUT_TOKENS=50000
# MAX_OUTPUT_TOKENS=50000

# System prompt is loaded from SYSTEM_PROMPT.md if it exists
