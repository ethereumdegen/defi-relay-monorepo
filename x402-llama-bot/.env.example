# DigitalOcean Agent Configuration
DO_AGENT_ENDPOINT=https://xxx.agents.do-ai.run
DO_AGENT_SECRET=your-do-agent-bearer-token

# Bot Wallet (receives payments)
BOT_WALLET_ADDRESS=0xYourBotWalletAddress

# Facilitator Service
FACILITATOR_URL=http://localhost:3000

# Server Configuration
PORT=8080
COST_PER_REQUEST=1000
