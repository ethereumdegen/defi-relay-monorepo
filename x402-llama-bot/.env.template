# x402-llama-bot Environment Configuration
# Copy this file to .env and fill in the values

# DigitalOcean Agent Configuration (REQUIRED)
# Your DigitalOcean AI agent endpoint URL
DO_AGENT_ENDPOINT=https://your-agent.agents.do-ai.run

# Bearer token for authenticating with the DO agent
DO_AGENT_SECRET=your-do-agent-bearer-token

# Bot Wallet Configuration (REQUIRED)
# Ethereum address that will receive payments
BOT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Facilitator Service (REQUIRED)
# URL of the x402 facilitator service for payment verification
FACILITATOR_URL=http://localhost:3000

# Server Configuration (OPTIONAL - defaults shown)
# Port the server will listen on
PORT=8080

# Cost per request in raw USDC units (6 decimals, so 1000 = 0.001 USDC)
COST_PER_REQUEST=1000

# Logging level (trace, debug, info, warn, error)
RUST_LOG=info
