# DeFi Relay RPC Configuration

# Required: Wallet address to receive payments
WALLET_ADDRESS=0x1234567890123456789012345678901234567890

# Required: x402 facilitator URL
FACILITATOR_URL=https://facilitator.x402.org

# Optional: Server port (default: 8080)
PORT=8080

# Optional: Cost per standard RPC request in raw USDC (6 decimals, default: 100 = $0.0001)
COST_PER_REQUEST=100

# Optional: Cost per heavy RPC request in raw USDC (6 decimals, default: 1000 = $0.001)
# Heavy methods: eth_getLogs, debug_trace*, trace_*, etc.
COST_PER_HEAVY_REQUEST=1000

# Optional: Base URL for x402 discovery document
BASE_URL=https://rpc.defirelay.com

# Network RPC URLs - add any networks you want to support
# Format: {NETWORK}_RPC_URL=<rpc-endpoint>

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Base
BASE_RPC_URL=https://mainnet.base.org

# Arbitrum
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com

# Testnets
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
